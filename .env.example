# Baza danych i logowanie (Supabase). Bez tych wartości aplikacja działa
# lokalnie, bez kont, z danymi w przeglądarce.
#
# Skopiuj ten plik jako .env.local i wpisz wartości z panelu Supabase:
# Project Settings -> API -> Project URL oraz klucz "anon" / "publishable".
# Klucz anon jest jawny z założenia; dostęp do danych pilnują zasady RLS
# z pliku supabase/schema.sql. Nigdy nie wpisuj tu klucza service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
